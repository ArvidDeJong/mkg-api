{
    "name": "darvis/mkg-api",
    "description": "Abandoned Laravel client for the MKG ERP REST API. Use darvis/mkg-client instead.",
    "type": "library",
    "license": "MIT",
    "abandoned": "darvis/mkg-client",
    "homepage": "https://arviddejong.github.io/mkg-client/",
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "arvid@darvis.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/mkg-client/issues",
        "source": "https://github.com/ArvidDeJong/mkg-api"
    },
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\Mkg\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\Mkg\\MkgServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
